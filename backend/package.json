{
  "name": "replica-generator",
  "version": "1.0.0",
  "description": "Generates a new IDE-based coding assessment scenario (prefilled_code, solution_code, testcase, IDE_BASED_CODING) from a base scenario and a transformation spec.",
  "private": true,
  "type": "module",
  "main": "dist/cli/main.js",
  "bin": {
    "replica-generator": "dist/cli/main.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli/main.ts",
    "generate": "tsx src/cli/main.ts generate",
    "analyze": "tsx src/cli/main.ts analyze",
    "serve": "tsx src/api/server.ts",
    "start": "node dist/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "adm-zip": "^0.6.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "openai": "^7.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/adm-zip": "^0.5.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.10.2",
    "@typescript-eslint/eslint-plugin": "^8.18.1",
    "@typescript-eslint/parser": "^8.18.1",
    "eslint": "^9.17.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
