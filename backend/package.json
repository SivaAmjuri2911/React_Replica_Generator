{
  "name": "replica-generator",
  "version": "1.0.0",
  "description": "Generates a new IDE-based coding assessment scenario (prefilled_code, solution_code, testcase, IDE_BASED_CODING) from a base scenario and a transformation spec.",
  "private": true,
  "type": "module",
  "main": "src/api/server.js",
  "bin": {
    "replica-generator": "src/cli/main.js"
  },
  "scripts": {
    "dev": "node --watch src/cli/main.js",
    "generate": "node src/cli/main.js generate",
    "analyze": "node src/cli/main.js analyze",
    "serve": "node src/api/server.js",
    "serve:watch": "node --watch src/api/server.js",
    "start": "node src/api/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "migrate:ide-based-coding": "node scripts/migrateIdeBasedCodingPaths.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "adm-zip": "^0.6.0",
    "commander": "^12.1.0",
    "cors": "^2.8.5",
    "esbuild": "^0.28.1",
    "express": "^4.21.2",
    "multer": "^2.2.0",
    "openai": "^7.3.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
