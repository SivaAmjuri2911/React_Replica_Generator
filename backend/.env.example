# Mistral AI — used by CLI when --provider mistral and no --api-key is passed.
# The web UI accepts the key per request instead; it is never persisted server-side.
MISTRAL_API_KEY=

# Optional — public URL of this API (no trailing slash). Render sets RENDER_EXTERNAL_URL
# automatically; set this only when overriding, e.g. https://react-replica-generator.onrender.com
# PUBLIC_API_BASE_URL=
