# Base URL the frontend calls for the API. Leave unset for local dev (uses the
# vite.config.ts dev-server proxy) or when a reverse proxy serves both origins
# together. Set to the backend's full URL when they're deployed separately,
# e.g. VITE_API_BASE_URL=https://replica-generator-api.onrender.com/api


VITE_API_BASE_URL=https://react-replica-generator.onrender.com/api
